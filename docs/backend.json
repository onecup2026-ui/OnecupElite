
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Données utilisateur étendues",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoUrl": { "type": "string" },
        "bio": { "type": "string" },
        "gameIDs": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["username", "email", "createdAt"]
    },
    "Tournament": {
      "title": "Tournament",
      "description": "Détails d'un tournoi élite",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "gameType": { "type": "string" },
        "startDate": { "type": "string", "format": "date-time" },
        "endDate": { "type": "string", "format": "date-time" },
        "registrationDeadline": { "type": "string", "format": "date-time" },
        "organizerId": { "type": "string", "description": "UID de l'organisateur" },
        "description": { "type": "string" },
        "rules": { "type": "string" },
        "entryFee": { "type": "number", "default": 0 },
        "maxTeams": { "type": "number", "default": 16 },
        "imageUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["Inscriptions Ouvertes", "En Cours", "Terminé"] }
      },
      "required": ["name", "gameType", "startDate", "imageUrl"]
    },
    "Team": {
      "title": "Team",
      "description": "Équipe de tournoi",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "captainId": { "type": "string" },
        "tagline": { "type": "string" },
        "logoUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "captainId", "createdAt"]
    },
    "TournamentRegistration": {
      "title": "Tournament Registration",
      "description": "Inscription d'une équipe ou d'un joueur à un tournoi",
      "type": "object",
      "properties": {
        "tournamentId": { "type": "string" },
        "teamId": { "type": "string" },
        "userId": { "type": "string" },
        "registrationDate": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "default": "En attente" }
      },
      "required": ["tournamentId", "registrationDate", "status"]
    },
    "Match": {
      "title": "Match",
      "description": "Détails d'une rencontre",
      "type": "object",
      "properties": {
        "tournamentId": { "type": "string" },
        "team1Id": { "type": "string" },
        "team2Id": { "type": "string" },
        "matchNumber": { "type": "number" },
        "scheduledTime": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["À Venir", "En Cours", "Terminé"] },
        "scoreTeam1": { "type": "number", "default": 0 },
        "scoreTeam2": { "type": "number", "default": 0 },
        "winnerId": { "type": "string" },
        "resultDetails": { "type": "string" }
      },
      "required": ["tournamentId", "team1Id", "team2Id", "matchNumber", "scheduledTime", "status"]
    },
    "TeamMembership": {
      "title": "Team Membership",
      "description": "Lien entre un utilisateur et une équipe",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "teamId": { "type": "string" },
        "joinedAt": { "type": "string", "format": "date-time" },
        "role": { "type": "string", "enum": ["Capitaine", "Membre"] }
      },
      "required": ["userId", "teamId", "joinedAt", "role"]
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Profils utilisateurs"
    },
    "/tournaments/{tournamentId}": {
      "schema": "Tournament",
      "description": "Tournois"
    },
    "/teams/{teamId}": {
      "schema": "Team",
      "description": "Équipes"
    },
    "/registrations/{registrationId}": {
      "schema": "TournamentRegistration",
      "description": "Inscriptions"
    },
    "/matches/{matchId}": {
      "schema": "Match",
      "description": "Matchs"
    },
    "/teamMemberships/{membershipId}": {
      "schema": "TeamMembership",
      "description": "Membres d'équipes"
    }
  }
}
