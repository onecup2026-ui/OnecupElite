{
  "entities": {
    "User": {
      "title": "User",
      "description": "Profil utilisateur étendu selon le schéma @table",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "email": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "displayName": { "type": "string" },
        "photoUrl": { "type": "string" },
        "bio": { "type": "string" },
        "gameIDs": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["username", "email", "createdAt"]
    },
    "Tournament": {
      "title": "Tournament",
      "description": "Détails d'un tournoi élite",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "gameType": { "type": "string" },
        "startDate": { "type": "string", "format": "date-time" },
        "endDate": { "type": "string", "format": "date-time" },
        "registrationDeadline": { "type": "string", "format": "date-time" },
        "organizerId": { "type": "string", "description": "UID de l'utilisateur organisateur" },
        "description": { "type": "string" },
        "rules": { "type": "string" },
        "entryFee": { "type": "number", "default": 0 },
        "maxTeams": { "type": "number", "default": 16 }
      },
      "required": ["name", "gameType", "startDate", "endDate", "registrationDeadline", "organizerId"]
    },
    "Team": {
      "title": "Team",
      "description": "Équipe de tournoi",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "captainId": { "type": "string", "description": "UID du capitaine" },
        "createdAt": { "type": "string", "format": "date-time" },
        "tagline": { "type": "string" },
        "logoUrl": { "type": "string" }
      },
      "required": ["name", "captainId", "createdAt"]
    },
    "TournamentRegistration": {
      "title": "Tournament Registration",
      "description": "Inscription à un tournoi",
      "type": "object",
      "properties": {
        "tournamentId": { "type": "string" },
        "teamId": { "type": "string" },
        "userId": { "type": "string", "description": "Pour les inscriptions individuelles" },
        "registrationDate": { "type": "string", "format": "date-time" },
        "status": { "type": "string" }
      },
      "required": ["tournamentId", "registrationDate", "status"]
    },
    "Match": {
      "title": "Match",
      "description": "Détails d'une rencontre",
      "type": "object",
      "properties": {
        "tournamentId": { "type": "string" },
        "team1Id": { "type": "string" },
        "team2Id": { "type": "string" },
        "matchNumber": { "type": "number" },
        "scheduledTime": { "type": "string", "format": "date-time" },
        "status": { "type": "string" },
        "scoreTeam1": { "type": "number", "default": 0 },
        "scoreTeam2": { "type": "number", "default": 0 },
        "winnerId": { "type": "string" },
        "resultDetails": { "type": "string" }
      },
      "required": ["tournamentId", "team1Id", "team2Id", "matchNumber", "scheduledTime", "status"]
    },
    "TeamMembership": {
      "title": "Team Membership",
      "description": "Lien entre un utilisateur et une équipe",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "teamId": { "type": "string" },
        "joinedAt": { "type": "string", "format": "date-time" },
        "role": { "type": "string" }
      },
      "required": ["userId", "teamId", "joinedAt", "role"]
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/users/{userId}": { "schema": "User", "description": "Profils utilisateurs" },
    "/tournaments/{tournamentId}": { "schema": "Tournament", "description": "Tournois" },
    "/teams/{teamId}": { "schema": "Team", "description": "Équipes" },
    "/registrations/{registrationId}": { "schema": "TournamentRegistration", "description": "Inscriptions" },
    "/matches/{matchId}": { "schema": "Match", "description": "Matchs" },
    "/teamMemberships/{membershipId}": { "schema": "TeamMembership", "description": "Membres d'équipes" }
  }
}
